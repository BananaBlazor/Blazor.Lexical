@page "/harness/overlays"

<PageTitle>Harness — overlays</PageTitle>

<h1>Overlays</h1>

<section>
    <h2>Overlays — floating toolbar, slash menu, drag handle (pure JS, zero interop)</h2>
    @* No callbacks wired: proves the in-editor overlays are entirely client-side.
       The overlays activate purely from the marker markup they render. *@
    <LexicalEditor Id="editor-overlays"
                   CssClass="harness-overlays"
                   Placeholder="Type '/' for blocks, select text for the toolbar…"
                   Theme="LexicalTheme.Default">
        <LexicalFloatingToolbar />
        <LexicalSlashMenu />
        @* The playground-style left rail, composed from its two items. *@
        <LexicalBlockGutter Position="LexicalGutterPosition.LeftInside">
            <LexicalAddBlockButton />
            <LexicalDragHandle />
        </LexicalBlockGutter>
    </LexicalEditor>
</section>

<section>
    <h2>Overlays — inside a short overflow:hidden container</h2>
    @* The container would clip root-positioned overlays; the top-layer floating toolbar
       and slash menu must escape it. The spacer lets a test scroll it to the viewport top. *@
    <div id="overlays-clip-container" style="overflow: hidden; height: 3rem; border: 1px solid #ccc">
        <LexicalEditor Id="editor-overlays-clip"
                       CssClass="harness-overlays-clip"
                       Theme="LexicalTheme.Default">
            <LexicalFloatingToolbar />
            <LexicalSlashMenu />
        </LexicalEditor>
    </div>
    <div style="height: 100vh"></div>
</section>
